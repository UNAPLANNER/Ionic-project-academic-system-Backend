{
  "name": "ionic-project-academic-system-backend",
  "version": "1.0.0",
  "description": "Sistema académico móvil aplicación móvil que permite gestionar estudiantes, cursos, evaluaciones y visualización de desempeño académico, incorporando diferentes niveles de acceso según el tipo de usuario.",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --detectOpenHandles --forceExit --runInBand",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit --runInBand",
    "lint": "eslint src/ tests/ --ext .js",
    "build": "node --check src/app.js && node --check src/index.js && echo Build OK"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UNAPLANNER/Ionic-project-academic-system-Backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/UNAPLANNER/Ionic-project-academic-system-Backend/issues"
  },
  "homepage": "https://github.com/UNAPLANNER/Ionic-project-academic-system-Backend#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-jest": "^29.15.2",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
